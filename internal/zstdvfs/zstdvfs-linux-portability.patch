diff --git a/Makefile b/Makefile
index aff1247..c15d0f2 100644
--- a/Makefile
+++ b/Makefile
@@ -1,5 +1,9 @@
 CC ?= cc
-CFLAGS = -std=c11 -g -O2 -Wall -Wextra -Werror -Isrc -Ithird_party/sqlite
+CFLAGS = -std=c11 -g -O2 -Wall -Wextra -Werror -Isrc -Ithird_party/sqlite -D_DEFAULT_SOURCE
+# A dlopen'd extension resolves sqlite3_* against the test binary's own
+# statically linked SQLite. ELF hides those symbols unless asked; Mach-O
+# exports them anyway.
+TEST_EXPORT_DYNAMIC = $(if $(filter Linux,$(shell uname -s)),-rdynamic,)
 ZSTD_CFLAGS := $(shell pkg-config --cflags libzstd)
 ZSTD_LIBS   := $(shell pkg-config --libs libzstd)
 SQLITE_ZIP  := sqlite-amalgamation-3500400
@@ -49,7 +53,7 @@ build/faultvfs.o: test/faultvfs.c test/faultvfs.h | build
 build/%: test/unit/%.c build/libzstdvfs.a build/faultvfs.o third_party/sqlite3.o | build
 	$(CC) $(CFLAGS) $(ZSTD_CFLAGS) -Itest $< build/faultvfs.o build/libzstdvfs.a third_party/sqlite3.o $(ZSTD_LIBS) -lpthread -o $@
 build/%: test/integration/%.c build/libzstdvfs.a build/faultvfs.o third_party/sqlite3.o | build
-	$(CC) $(CFLAGS) $(ZSTD_CFLAGS) -Itest $< build/faultvfs.o build/libzstdvfs.a third_party/sqlite3.o $(ZSTD_LIBS) -lpthread -o $@
+	$(CC) $(CFLAGS) $(ZSTD_CFLAGS) -Itest $< build/faultvfs.o build/libzstdvfs.a third_party/sqlite3.o $(ZSTD_LIBS) -lpthread $(TEST_EXPORT_DYNAMIC) -o $@
 
 build/test_ext: $(EXT)
 
diff --git a/src/container.c b/src/container.c
index 00ae023..690dd96 100644
--- a/src/container.c
+++ b/src/container.c
@@ -1,6 +1,6 @@
 #include "zvfs_int.h"
 
-void zhdr_encode(const ZvfsHdr *h, u8 *o){
+void zhdr_encode(const ZvfsHdr *h, u8 o[ZVFS_HDR_COPY_SIZE]){
   memset(o, 0, ZVFS_HDR_COPY_SIZE);
   memcpy(o, ZVFS_MAGIC, 16);
   put32le(o+16, 1);            /* format_version */
@@ -15,7 +15,7 @@ void zhdr_encode(const ZvfsHdr *h, u8 *o){
   put32le(o+76, h->flags);
   put32le(o+508, zcrc32(0, o, 508));
 }
-int zhdr_decode(const u8 *i, ZvfsHdr *h){
+int zhdr_decode(const u8 i[ZVFS_HDR_COPY_SIZE], ZvfsHdr *h){
   if(memcmp(i, ZVFS_MAGIC, 16)!=0) return SQLITE_NOTADB;
   if(get32le(i+508) != zcrc32(0, i, 508)) return SQLITE_NOTADB;
   if(get32le(i+16)!=1 || get32le(i+20)!=1) return SQLITE_NOTADB;
@@ -39,7 +39,7 @@ int zhdr_pick(const u8 *a, const u8 *b, ZvfsHdr *out, int *pWhich){
   return SQLITE_OK;
 }
 
-void zrec_encode(const ZvfsRec *r, u8 *o){
+void zrec_encode(const ZvfsRec *r, u8 o[ZVFS_REC_HDR_SIZE]){
   put16le(o, ZVFS_REC_MAGIC);
   o[2] = r->type; o[3] = r->flags;
   put32le(o+4, r->nPayload);
@@ -47,7 +47,7 @@ void zrec_encode(const ZvfsRec *r, u8 *o){
   put32le(o+16, r->crc);
   put32le(o+20, 0);
 }
-int zrec_decode(const u8 *i, ZvfsRec *r){
+int zrec_decode(const u8 i[ZVFS_REC_HDR_SIZE], ZvfsRec *r){
   if(get16le(i)!=ZVFS_REC_MAGIC) return SQLITE_IOERR_READ;
   r->type=i[2]; r->flags=i[3];
   r->nPayload=get32le(i+4); r->key=get64le(i+8); r->crc=get32le(i+16);
