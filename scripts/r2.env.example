# R2 credentials for scripts/upload-r2.py. Copy to a file OUTSIDE the repo,
# fill it in, chmod 600, and `source` it before uploading:
#
#   cp scripts/r2.env.example /tank/mediadb/.r2.env
#   chmod 600 /tank/mediadb/.r2.env
#   set -a; . /tank/mediadb/.r2.env; set +a
#   scripts/upload-r2.py --dry-run
#
# From the Cloudflare dashboard: R2 > API > Manage API tokens > Create token,
# permission "Object Read & Write", scoped to this one bucket. The account ID
# is on the R2 overview page; it is also the first path element of the S3
# endpoint Cloudflare shows you.

export R2_ACCOUNT_ID=
export R2_ACCESS_KEY_ID=
export R2_SECRET_ACCESS_KEY=
export R2_BUCKET=filmstock
